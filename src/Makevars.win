LIBMSEED_SRCS = \
    libmseed/fileutils.c \
    libmseed/genutils.c \
    libmseed/msio.c \
    libmseed/lookup.c \
    libmseed/yyjson.c \
    libmseed/msrutils.c \
    libmseed/extraheaders.c \
    libmseed/pack.c \
    libmseed/packdata.c \
    libmseed/tracelist.c \
    libmseed/gmtime64.c \
    libmseed/crc32c.c \
    libmseed/parseutils.c \
    libmseed/unpack.c \
    libmseed/unpackdata.c \
    libmseed/selection.c \
    libmseed/logging.c

LIBMSEED_OBJS = $(LIBMSEED_SRCS:.c=.o)

# eseis C and C++ sources
PKG_C_SRCS = \
    eseis_init.c \
    parseMiniSEED_v3.c \
    writeMiniSEED_v3_v3.c \
    writeMiniSEED_v3_v2.c

PKG_CPP_SRCS = \
    RcppExports.cpp \
    correlation_event.cpp \
    kurtosis_event.cpp \
    run_cor.cpp \
    stalta_event_freeze.cpp \
    stalta_event_nofreeze.cpp

PKG_C_OBJS   = $(PKG_C_SRCS:.c=.o)
PKG_CPP_OBJS = $(PKG_CPP_SRCS:.cpp=.o)

OBJECTS = $(LIBMSEED_OBJS) $(PKG_C_OBJS) $(PKG_CPP_OBJS)

PKG_CPPFLAGS = -I$(srcdir)/libmseed \
    -DWIN32 \
    -D_CRT_SECURE_NO_WARNINGS \
    -D__USE_MINGW_ANSI_STDIO=1 \
    -D_FORTIFY_SOURCE=0

PKG_LIBS =

$(SHLIB): $(OBJECTS)
	$(CXX) -shared -o $@ $(OBJECTS) $(PKG_LIBS)

